package views

import (
	"strconv"

	"cad-development/internal/task"
)

templ GridPage(data task.Grid) {
	@Layout("CAD Development") {
		<div class="workspace">
			@Grid(data)
		</div>
	}
}

	templ Grid(data task.Grid) {
		<section id="grid" class={ gridClass(data) }>
		<header class="project-header">
			<div class="project-heading">
				<p class="eyebrow">WORKBOARD
					if data.SubprojectName != "" {
						<span> / { data.SubprojectName }</span>
					}
				</p>
				<h1>{ data.ProjectName }</h1>
				if data.Kind == task.ViewIdeas {
					<p class="project-description">Unassigned tasks and ideas. Weekly planning is available after assigning a project.</p>
				} else if data.Kind == task.ViewAll {
					<p class="project-description">All tasks across projects. Select a project to open its weekly planning view.</p>
				} else {
					<p class="project-description"><span>PO { data.POName }</span><span>{ dateLabel(data.StartDate) } - { dateLabel(data.EndDate) }</span></p>
				}
			</div>
			if task.IsWeekly(data.Kind) {
				<div class="project-actions">
					<button type="button" hx-get={ templ.URL("/projects/" + data.FilterProject + "/edit") } hx-target="#modal-root" hx-swap="innerHTML">Edit project</button>
					if data.FilterSubproject != "" {
						<button type="button" hx-get={ templ.URL("/subprojects/" + data.FilterSubproject + "/edit") } hx-target="#modal-root" hx-swap="innerHTML">Edit subproject</button>
					} else {
						<button type="button" hx-get={ templ.URL("/subprojects/new?project_id=" + data.FilterProject) } hx-target="#modal-root" hx-swap="innerHTML">+ Add subproject</button>
					}
					<button type="button" hx-get={ templ.URL("/tasks/new?project_id=" + data.FilterProject) } hx-target="#modal-root" hx-swap="innerHTML" class="action-primary">+ Add task</button>
				</div>
			}
		</header>
		if task.IsWeekly(data.Kind) {
			@GridTotals(data)
		}
		<div class="workboard-toolbar">
			<form id="filters" class="filters" hx-get="/" hx-target="#grid" hx-swap="outerHTML" hx-push-url="true" hx-trigger="change">
				<span class="toolbar-label">View</span>
				<label>
					<span class="sr-only">Project</span>
					<select name="project" id="project-filter">
						for _, o := range data.Projects {
							<option value={ o.Value } selected?={ o.Selected }>{ o.Label }</option>
						}
					</select>
				</label>
				if task.IsWeekly(data.Kind) {
					<label>
						<span class="sr-only">Subproject</span>
						<select name="subproject" id="subproject-filter">
							for _, o := range data.Subprojects {
								<option value={ o.Value } selected?={ o.Selected }>{ o.Label }</option>
							}
						</select>
					</label>
				}
			</form>
			if task.IsWeekly(data.Kind) {
				<div class="workboard-actions">
					<button type="button" class="jump-week" data-current-week={ data.CurrentWeek }>Jump to current week</button>
					<div class="historical-editing-controls">
						<span class="historical-editing-status">
							if data.HistoricalEditingAllowed {
								Historical editing allowed
							} else {
								Historical weeks locked by default
							}
						</span>
						<div class="historical-editing-actions">
							<form hx-post="/history-access/set" hx-target="#grid" hx-swap="outerHTML" hx-include="#filters">
								if data.HistoricalEditingAllowed {
									<input type="hidden" name="historical_editing" value="false"/>
									<button type="submit" class="secondary outline">Stop historical editing</button>
								} else {
									<input type="hidden" name="historical_editing" value="true"/>
									<button type="submit" class="secondary outline">Allow historical editing</button>
								}
							</form>
						</div>
					</div>
				</div>
			}
		</div>
		<div class="table-scroll">
			<table class="week-table">
				<colgroup>
					<col class="c0"/>
					<col class="c1"/>
					<col class="c2"/>
					<col class="c3"/>
					if data.Kind != task.ViewIdeas {
						<col class="c4"/>
					}
					if task.IsWeekly(data.Kind) {
						for range data.Weeks {
							<col class="week-col"/>
						}
					}
				</colgroup>
				<thead>
					if task.IsWeekly(data.Kind) {
						<tr class="group-row">
							<th colspan="4" class="sticky c0">Task information</th>
							<th class="sticky c4">Summary</th>
							<th colspan={ len(data.Weeks) } class="timeline-group">Weekly timeline</th>
						</tr>
					}
					if task.IsWeekly(data.Kind) {
						<tr class="month-row">
							<th colspan="5" class="sticky c0">Month</th>
							for _, month := range distinctMonths(data.Weeks) {
								<th colspan={ month.Count } class="month-group">{ month.Label }</th>
							}
						</tr>
					}
					<tr class="column-row">
						<th class="sticky c0">Task</th>
						if data.Kind == task.ViewIdeas {
							<th class="sticky c1">Project</th>
							<th class="sticky c2">Subproject</th>
							<th class="sticky c3 idea-status">Assignment</th>
						} else {
							<th class="sticky c1">Project</th>
							<th class="sticky c2">Subproject</th>
							<th class="sticky c3">Status</th>
							<th class="sticky c4">Summary</th>
						}
						if task.IsWeekly(data.Kind) {
							for _, w := range data.Weeks {
								<th class={ "week-col " + weekColumnClass(w.Start, data.CurrentWeek) } title={ w.Start } data-week={ w.Start }><span>W{ strconv.Itoa(w.Number) }</span><small>{ w.Date }</small></th>
							}
						}
					</tr>
				</thead>
				<tbody>
					for _, row := range data.Rows {
						@TaskGridRow(row, data.Kind, data.CurrentWeek)
					}
				</tbody>
				if task.IsWeekly(data.Kind) {
					<tfoot>
						<tr>
							<th colspan="5" class="sticky c0">
								<div class="week-total-labels">
									<small>Plan</small>
									<small>Spent</small>
								</div>
							</th>
							for i, total := range data.WeekTotals {
								@WeekTotalCell(i, total, weekColumnClass(data.Weeks[i].Start, data.CurrentWeek))
							}
						</tr>
					</tfoot>
				}
			</table>
		</div>
	</section>
}

templ GridTotals(data task.Grid) {
	<div id="grid-totals" class="totals">
		@GridTotalsContent(data)
	</div>
}

templ GridTotalsOOB(data task.Grid) {
	<div id="grid-totals" class="totals" hx-swap-oob="outerHTML">
		@GridTotalsContent(data)
	</div>
}

	templ GridTotalsContent(data task.Grid) {
		<div class="metric"><small>Budget</small><strong>{ hours(data.BudgetHours) } h</strong></div>
		<div class={ "metric " + overrunClass(data.Overrun) }><small>Planned</small><strong>{ hours(data.PlannedHours) } h</strong></div>
		<div class="metric"><small>Spent</small><strong>{ hours(data.SpentHours) } h</strong></div>
		if data.ProgressPct != nil {
			<div class="metric"><small>Progress</small><strong>{ percent(*data.ProgressPct) }%</strong></div>
		}
		<small class={ "budget-hint " + overrunClass(data.Overrun) }>Planned { hours(data.PlannedHours) } h of { hours(data.BudgetHours) } h budget</small>
}

func gridClass(data task.Grid) string {
	class := "grid-main"
	if data.Kind == task.ViewIdeas {
		class += " ideas"
	}
	if data.HistoricalEditingAllowed && task.IsWeekly(data.Kind) {
		class += " historical-editing-allowed"
	}
	return class
}

templ WeekTotalCell(index int, total task.GridWeekTotal, weekClass string) {
	<td id={ "week-total-" + strconv.Itoa(index) } class={ "week-total " + weekClass }>@WeekTotalContent(total)</td>
}

templ WeekTotalCellOOB(index int, total task.GridWeekTotal, weekClass string) {
	<td id={ "week-total-" + strconv.Itoa(index) } class={ "week-total " + weekClass } hx-swap-oob="outerHTML">@WeekTotalContent(total)</td>
}

templ WeekTotalContent(total task.GridWeekTotal) {
	<small>{ hours(total.Planned) }</small><small>{ hours(total.Spent) }</small>
}

templ TaskGridRow(row task.GridRow, kind task.ViewKind, currentWeek string) {
	<tr id={ "task-row-" + strconv.FormatInt(row.ID, 10) } class="task-row">
		<td class="sticky c0">
			<button type="button" class="linkish" hx-get={ templ.URL(row.DetailPath) } hx-target="#modal-root" hx-swap="innerHTML">{ row.Name }</button>
		</td>
		<td class="sticky c1">{ row.ProjectName }</td>
		<td class="sticky c2">{ row.Subproject }</td>
		if kind == task.ViewIdeas {
			<td class="sticky c3 idea-status">Unassigned</td>
		} else {
			<td class="sticky c3">{ row.Status }</td>
			<td class="sticky c4">
				@TaskSummary(row)
			</td>
			if task.IsWeekly(kind) {
				for _, cell := range row.Cells {
					@WeekCellEditor(cell, currentWeek)
				}
			}
		}
	</tr>
}

templ TaskSummary(row task.GridRow) {
	<dl class="task-summary">
		<div><dt>Planned</dt><dd>{ hours(row.TotalHours) } h</dd></div>
		<div><dt>Spent</dt><dd>{ hours(row.SpentHours) } h</dd></div>
		<div><dt>Progress</dt><dd>{ percent(row.Progress) }%</dd></div>
	</dl>
}
