package views

import "cad-development/internal/task"

templ WeekCellEditor(cell task.GridCell) {
	<td class="week-cell">
		if cell.Error != "" {
			<div class="cell-error" role="alert">{ cell.Error }</div>
		}
		@WeekInput(cell, "Planned hours", "planned_hours", hours(cell.Planned), "", "planned", "")
		@WeekInput(cell, "Spent hours", "spent_hours", hours(cell.Spent), "", "spent", "")
		@WeekInput(cell, "Progress percent", "progress", percent(cell.Progress), "100", progressTitle(cell.Stored), progressClass(cell.Stored))
	</td>
}

templ WeekInput(cell task.GridCell, label string, name string, value string, max string, title string, cssClass string) {
	<input class={ cssClass } aria-label={ label } data-save-path={ cell.SavePath } type="number" step="any" min="0" { maxAttr(max)... } name={ name } value={ value } disabled?={ cell.Locked } title={ inputTitle(cell.Locked, title) } hx-post={ templ.URL(cell.SavePath) } hx-trigger="change" hx-target="closest tr" hx-swap="outerHTML" hx-include="this, #filters"/>
}

func maxAttr(max string) templ.Attributes {
	if max == "" {
		return nil
	}
	return templ.Attributes{"max": max}
}

templ WeekRowResponse(data task.Grid, rowIndex int) {
			@TaskGridRow(data.Rows[rowIndex], false)
	for i, total := range data.WeekTotals {
		@WeekTotalCellOOB(i, total, data.ProgressPct != nil)
	}
	@GridTotalsOOB(data)
}
