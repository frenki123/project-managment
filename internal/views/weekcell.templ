package views

import "cad-development/internal/task"

templ WeekCellEditor(cell task.GridCell) {
	<td class="week-cell">
		if cell.Error != "" {
			<div class="cell-error" role="alert">{ cell.Error }</div>
		}
		<input data-save-path={ cell.SavePath } type="number" step="any" min="0" name="planned_hours" value={ formatNum(cell.Planned) } disabled?={ cell.Locked } title="planned" hx-post={ templ.URL(cell.SavePath) } hx-trigger="change" hx-target="closest tr" hx-swap="outerHTML" hx-include="this, #filters"/>
		<input data-save-path={ cell.SavePath } type="number" step="any" min="0" name="spent_hours" value={ formatNum(cell.Spent) } disabled?={ cell.Locked } title="spent" hx-post={ templ.URL(cell.SavePath) } hx-trigger="change" hx-target="closest tr" hx-swap="outerHTML" hx-include="this, #filters"/>
		<input class={ progressClass(cell.Stored) } data-save-path={ cell.SavePath } type="number" step="any" min="0" max="100" name="progress" value={ formatNum(cell.Progress) } disabled?={ cell.Locked } title={ progressTitle(cell.Stored) } hx-post={ templ.URL(cell.SavePath) } hx-trigger="change" hx-target="closest tr" hx-swap="outerHTML" hx-include="this, #filters"/>
	</td>
}

templ WeekRowResponse(data task.Grid, rowIndex int) {
			@TaskGridRow(data.Rows[rowIndex], false)
	for i, total := range data.WeekTotals {
		@WeekTotalCellOOB(i, total)
	}
	@GridTotalsOOB(data)
}