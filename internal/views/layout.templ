package views

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="color-scheme" content="light dark"/>
			<link rel="stylesheet" href="/static/css/pico.min.css"/>
			<link rel="stylesheet" href="/static/css/app.css"/>
			<script src="/static/js/htmx.min.js" defer></script>
			<script src="/static/js/chart.umd.min.js" defer></script>
			<script src="/static/js/chart.js" defer></script>
			<script src="/static/js/app.js" defer></script>
			<title>{ title }</title>
		</head>
		<body hx-status:4xx:inherited="swap:none" hx-status:5xx:inherited="swap:none">
			<div id="toast" class="toast" role="alert" hidden></div>
			<div id="modal-backdrop" class="modal-backdrop" hidden></div>
			<aside id="modal-root" class="side-modal" role="dialog" aria-modal="true" aria-labelledby="modal-title" aria-hidden="true" tabindex="-1"></aside>
			<header class="app-header">
				<a href="/" class="brand">CAD Development</a>
				<nav class="primary-nav" aria-label="Primary">
					<a href="/" class="active">Workboard</a>
					<a href="/chart">S-curve</a>
				</nav>
				<nav class="header-actions" aria-label="Create">
					<button type="button" hx-get="/tasks/new" hx-target="#modal-root" hx-swap="innerHTML">+ New task</button>
					<button type="button" hx-get="/projects/new" hx-target="#modal-root" hx-swap="innerHTML">+ New project</button>
					<button type="button" hx-get="/subprojects/new" hx-target="#modal-root" hx-swap="innerHTML">+ New subproject</button>
				</nav>
			</header>
			{ children... }
		</body>
	</html>
}
